import("//build/test.gni")
import("//foundation/ability/form_fwk/form_fwk.gni")

module_output_path = "form_fwk/form_fwk/form_edit_extension"

ohos_unittest("FmsFormEditExtensionTest") {
  module_out_path = module_output_path

  sources = [ "fms_form_edit_extension_test.cpp" ]

  include_dirs = [
    "${form_fwk_path}/interfaces/inner_api/include",
    "${form_fwk_path}/frameworks/js/napi/form_edit_extension_context",
    "${form_fwk_path}/frameworks/js/napi/form_edit_extension_ability",
    "${form_fwk_path}/test/mock/include",
  ]

  configs = []

  deps = [
    "${form_fwk_napi_path}:form_edit_extension",
    "${form_fwk_path}:fmskit_native",
    "${form_fwk_path}:form_utils",
    "${form_fwk_path}:form_common_info",
  ]

  external_deps = [
    "ability_base:want",
    "ability_runtime:abilitykit_native",
    "ability_runtime:app_context",
    "ability_runtime:napi_common",
    "ability_runtime:runtime",
    "ability_runtime:ui_extension",
    "bundle_framework:appexecfwk_core",
    "c_utils:utils",
    "eventhandler:libeventhandler",
    "googletest:gmock_main",
    "hilog:libhilog",
    "ipc:ipc_core",
    "napi:ace_napi",
    "resource_management:resmgr",
    "samgr:samgr_proxy",
    "window_manager:libwm",
  ]
}

###############################################################################
group("unittest") {
  testonly = true

  deps = [ ":FmsFormEditExtensionTest" ]
}
###############################################################################
