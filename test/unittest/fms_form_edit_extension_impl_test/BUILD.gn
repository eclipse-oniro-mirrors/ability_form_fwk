import("//build/test.gni")
import("//foundation/ability/form_fwk/form_fwk.gni")

module_output_path = "form_fwk/form_fwk/form_edit_extension_impl"

ohos_unittest("FmsFormEditExtensionImplTest") {
  module_out_path = module_output_path

  sources = [
    "${form_fwk_path}/frameworks/js/napi/form_edit_extension_context/form_edit_extension_context.cpp",
    "${form_fwk_path}/frameworks/js/napi/form_edit_extension_context/js_form_edit_extension_impl.cpp",
    "${form_fwk_path}/test/unittest/fms_form_edit_extension_impl_test/fms_form_edit_extension_impl_test.cpp",
    "${form_fwk_path}/test/unittest/fms_form_edit_extension_impl_test/mock_js_form_edit_extension_context.cpp",
    "${form_fwk_path}/test/unittest/fms_form_edit_extension_impl_test/mock_napi_common_want.cpp",
  ]

  include_dirs = [
    "${form_fwk_path}/frameworks/js/napi/form_edit_extension_context",
    "${form_fwk_path}/interfaces/inner_api/include",
    "${form_fwk_path}/services/include",
    "${form_fwk_path}/test/unittest/fms_form_edit_extension_impl_test",
    "${form_fwk_path}/test/unittest/fms_form_edit_extension_impl_test/inner",
  ]

  configs = [
    "${form_fwk_path}/test:formmgr_test_config",
  ]

  cflags = []
  ldflags = [ "-Wl,--allow-multiple-definition" ]

  if (target_cpu == "arm") {
    cflags += [ "-DBINDER_IPC_32BIT" ]
  }

  if (ability_runtime_graphics) {
    defines = [
      "SUPPORT_SCREEN",
      "SUPPORT_GRAPHICS",
    ]
  }

  defines += [ "private=public" ]

  deps = [
    "${form_fwk_path}:fmskit_native",
    "${form_fwk_path}:libfms_internal_static",
    "${form_fwk_path}:form_utils",
    "${form_fwk_path}:form_common_info",
    "${form_fwk_path}:form_render_info",
  ]

  external_deps = [
    "ability_base:want",
    "ability_runtime:abilitykit_native",
    "ability_runtime:app_context",
    "ability_runtime:extensionkit_native",
    "ability_runtime:napi_common",
    "ability_runtime:runtime",
    "ability_runtime:ui_extension",
    "c_utils:utils",
    "googletest:gtest_main",
    "hilog:libhilog",
    "napi:ace_napi",
    "window_manager:libwm",
  ]

  use_exceptions = true
}

###############################################################################
group("unittest") {
  testonly = true

  deps = [ ":FmsFormEditExtensionImplTest" ]
}
###############################################################################
