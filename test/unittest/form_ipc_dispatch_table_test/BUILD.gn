import("//build/test.gni")
import("//foundation/ability/form_fwk/form_fwk.gni")

config("form_ipc_dispatch_table_test_config") {
  include_dirs = [
    "${form_fwk_path}/interfaces/inner_api/include",
  ]
}

ohos_unittest("FormIpcDispatchTableTest") {
  module_out_path = "form_fwk/form_fwk/form_ipc_dispatch_table"

  configs = [ ":form_ipc_dispatch_table_test_config" ]

  sources = [
    "form_ipc_dispatch_table_test.cpp",
  ]

  deps = [
    "${form_fwk_path}:form_manager",
  ]

  external_deps = [
    "bundle_framework:appexecfwk_base",
    "c_utils:utils",
    "hilog:libhilog",
    "ipc:ipc_core",
    "googletest:gmock_main",
  ]
}

group("unittest") {
  testonly = true
  deps = [ ":FormIpcDispatchTableTest" ]
}
