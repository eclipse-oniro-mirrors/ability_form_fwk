import("//build/test.gni")
import("//foundation/ability/form_fwk/form_fwk.gni")

config("form_mgr_stub_test_config") {
  include_dirs = [
    "${form_fwk_path}/interfaces/kits/native/include",
    "${form_fwk_path}/test/mock/include",
  ]
}

ohos_unittest("FmsFormMgrStubTest") {
  module_out_path = "form_fwk/form_fwk/form_mgr_stub"

  configs = [ ":form_mgr_stub_test_config" ]

  sources = [
    "${form_fwk_path}/test/mock/src/mock_form_provider_client.cpp",
    "form_mgr_stub_test.cpp",
    "form_mgr_stub_color_info_test.cpp",
    # The production DSO exports only GetInstance/SetAccessChecker via
    # libform_manager.map; the test exercises the table and handlers directly.
    "${form_fwk_path}/interfaces/inner_api/src/form_ipc_dispatch_table.cpp",
    "${form_fwk_path}/interfaces/inner_api/src/form_ipc_handlers.cpp",
    "${form_fwk_path}/interfaces/inner_api/src/form_ashmem.cpp",
    "${form_fwk_path}/interfaces/inner_api/src/form_color_info.cpp",
    "${form_fwk_path}/interfaces/inner_api/src/form_info_filter.cpp",
    "${form_fwk_path}/interfaces/inner_api/src/form_instances_filter.cpp",
    "${form_fwk_path}/interfaces/inner_api/src/form_instance.cpp",
    "${form_fwk_path}/interfaces/inner_api/src/form_js_info.cpp",
    "${form_fwk_path}/interfaces/inner_api/src/form_lock_info.cpp",
    "${form_fwk_path}/interfaces/inner_api/src/form_major_info.cpp",
    "${form_fwk_path}/interfaces/inner_api/src/form_provider_data.cpp",
    "${form_fwk_path}/interfaces/inner_api/src/form_provider_info.cpp",
    "${form_fwk_path}/interfaces/inner_api/src/form_share_info.cpp",
    "${form_fwk_path}/interfaces/inner_api/src/running_form_info.cpp",
    "${form_fwk_path}/common/src/json_util_form.cpp",
  ]

  deps = [
    "${form_fwk_path}:form_manager",
    "${form_fwk_path}:libfms_internal_static",
    "${form_fwk_path}:form_render_info",
    "${form_fwk_path}:form_utils",
    "${form_fwk_path}:form_common_info",
  ]

  external_deps = [
    "ability_base:want",
    "ability_runtime:ability_connect_callback_stub",
    "ability_runtime:app_manager",
    "bundle_framework:appexecfwk_base",
    "bundle_framework:appexecfwk_core",
    "c_utils:utils",
    "eventhandler:libeventhandler",
    "googletest:gmock_main",
    "hilog:libhilog",
    "ipc:ipc_core",
    "samgr:samgr_proxy",
  ]
}

group("unittest") {
  testonly = true
  deps = [ ":FmsFormMgrStubTest" ]
}
