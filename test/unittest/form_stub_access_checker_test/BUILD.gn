import("//build/test.gni")
import("//foundation/ability/form_fwk/form_fwk.gni")

config("form_stub_access_checker_test_config") {
  include_dirs = [
    "${form_fwk_path}/interfaces/inner_api/include",
    "${form_fwk_path}/services/include",
    "${form_fwk_path}/test/mock/include",
  ]
}

ohos_unittest("FormStubAccessCheckerTest") {
  module_out_path = "form_fwk/form_fwk/form_stub_access_checker"

  configs = [ ":form_stub_access_checker_test_config" ]

  sources = [
    "${form_fwk_path}/test/mock/src/mock_ipc_skeleton.cpp",
    "form_stub_access_checker_test.cpp",
    "mock_form_util.cpp",
    "mock_tokenid_kit.cpp",
  ]

  ldflags = [ "-Wl,--allow-multiple-definition" ]

  deps = [ "${form_fwk_path}:libfms_internal_static" ]

  external_deps = [
    "ability_base:want",
    "access_token:libaccesstoken_sdk",
    "access_token:libtokenid_sdk",
    "bundle_framework:appexecfwk_base",
    "c_utils:utils",
    "googletest:gmock_main",
    "hilog:libhilog",
    "ipc:ipc_core",
  ]
}

group("unittest") {
  testonly = true
  deps = [ ":FormStubAccessCheckerTest" ]
}
